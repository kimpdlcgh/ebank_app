rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to system configuration
    match /systemConfig/{document} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }
    
    // Allow public read access to countries collection
    match /countries/{document} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }
    
    // Users collection - restricted access for security
    match /users/{userId} {
      // Allow authenticated users to read their own data
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow authenticated users to update their own profile fields,
      // but block privilege escalation or identity tampering.
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email;
      
      // Allow users to bootstrap only a client profile for themselves.
      // This blocks creating privileged roles from untrusted clients.
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'client' &&
        (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      
      // Allow admins to read/write all user data
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
      
      // Allow creation of new users by admins
      allow create: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');

      // Public username lookup should use /users_public, not /users.
    }

    // Public lookup collection for client login
    match /users_public/{userId} {
      allow read: if true;
      allow write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }
    
    // Bank accounts collection
    match /accounts/{accountId} {
      // Users can read their own accounts
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Admins can read/write all accounts
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');

      // Allow account creation by admins
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Users can submit their own pending deposit/withdrawal requests.
      // Trade settlements, approvals, and status changes are admin-only (below).
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        (request.resource.data.type == 'deposit' || request.resource.data.type == 'withdrawal');

      // Admins can read/write all transactions
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }
    
    // Support requests collection
    match /supportRequests/{requestId} {
      // Users can create/read/update/delete only their own support requests
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      
      // Admins can read/write all support requests
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Support requests collection (snake_case)
    match /support_requests/{requestId} {
      // Clients can create their own support requests (authenticated only)
      allow create: if request.auth != null &&
        request.resource.data.user.uid == request.auth.uid;

      // Clients can read their own tickets; admins can read all
      allow read: if request.auth != null && (
        resource.data.user.uid == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'))
      );

      // Only admins can update/delete support requests
      allow update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');

      // Responses subcollection
      match /responses/{responseId} {
        // Ticket owner can read; admins can read/write
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/support_requests/$(requestId)).data.user.uid == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'))
        );
        allow create: if request.auth != null &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
      }
    }

    // Password reset requests
    match /password_reset_requests/{requestId} {
      // Public create is allowed, but enforce a minimal valid request payload.
      allow create: if
        request.resource.data.username is string &&
        request.resource.data.username.size() > 0 &&
        request.resource.data.username.size() <= 64 &&
        request.resource.data.firstName is string &&
        request.resource.data.firstName.size() > 0 &&
        request.resource.data.firstName.size() <= 100 &&
        request.resource.data.lastName is string &&
        request.resource.data.lastName.size() > 0 &&
        request.resource.data.lastName.size() <= 100 &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 1000 &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Admin notifications
    match /admin_notifications/{notificationId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }
    
    // FAQ collection - public read access
    match /faqs/{faqId} {
      allow read: if true;

      // Only admins can write FAQs
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Live user/profile records. The app reads/writes user identity here
    // (see profileAdapter.ts: USER_COLLECTION = 'profiles'), not /users.
    // This block was missing, which meant profile access fell through to
    // the default-deny rule below unless the deployed rules differ from
    // this file.
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role;

      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.role == 'client';

      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Admin-managed account/product categories - public read, admin write
    match /account_categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Tradable instruments - public read (prices), admin write
    match /instruments/{instrumentId} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Per-account brokerage positions - owner read, admin read/write
    match /positions/{positionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Client-submitted brokerage orders
    match /brokerage_orders/{orderId} {
      // Owner can read their own orders
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Owner can place a new order for themselves, starting in 'open' status
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open';

      // Owner may only cancel their own still-open order (no other field may change)
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'open' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.quantity == resource.data.quantity &&
        request.resource.data.instrumentId == resource.data.instrumentId;

      // Admins can read/write all orders (fill/cancel/reject)
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Per-client watchlist
    match /watchlist/{itemId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Append-only admin action audit trail - admin read/create only, no edits
    match /audit_logs/{logId} {
      allow read, create: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Internal admin notes/flags on client profiles - admin only
    match /client_notes/{noteId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}