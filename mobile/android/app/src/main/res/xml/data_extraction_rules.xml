<?xml version="1.0" encoding="utf-8"?>
<!--
  Disables cloud backup and device-to-device transfer of app data (Android 12+).
  Appropriate for a financial app: session/auth data lives in the WebView and
  should not be copied off-device via adb backup or transfer.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
