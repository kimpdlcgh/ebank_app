rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cross-service check against the app's Firestore profile doc (named
    // database "safeguardsecurities" - see src/config/firebase.ts). Uses
    // exists()+get() (2 reads) to stay within Storage Rules' 2-document cap.
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/safeguardsecurities/documents/profiles/$(request.auth.uid)) &&
        firestore.get(/databases/safeguardsecurities/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // Client profile photos - see Profile.tsx (`profiles/{uid}/profile-*.ext`)
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow write: if isAdmin();
    }

    // Site branding assets - see SystemSettings.tsx (`branding/logo-primary-*`)
    match /branding/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
