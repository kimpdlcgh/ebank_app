# Copy this file to "keystore.properties" (same folder) and fill in real values.
# keystore.properties is gitignored — NEVER commit it or the .jks file.
#
# Generate a keystore (valid 10000 days) with:
#   keytool -genkeypair -v -keystore safeguard-release.jks \
#     -alias safeguard -keyalg RSA -keysize 2048 -validity 10000
#
# Then back up safeguard-release.jks AND these passwords somewhere safe.
# Losing the key means you can never update the app on Google Play.

# Path to the keystore, relative to the android/ folder (or absolute).
storeFile=safeguard-release.jks
storePassword=CHANGE_ME
keyAlias=safeguard
keyPassword=CHANGE_ME
