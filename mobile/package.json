{
  "name": "safeguard-securities-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Safeguard Securities Android app (Capacitor shell)",
  "scripts": {
    "cap:sync": "cap sync",
    "cap:sync:android": "cap sync android",
    "cap:sync:ios": "cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "ios:add": "cap add ios",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "aab": "powershell -ExecutionPolicy Bypass -File build-aab.ps1",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-android-icons.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "typescript": "^5.8.3"
  },
  "capacitor": {
    "platforms": [
      "android",
      "ios"
    ]
  }
}
